// Prometheus Node Exporter metrics (Hardware stats)
prometheus.exporter.unix "default" { }

prometheus.scrape "unix" {
  targets    = prometheus.exporter.unix.default.targets
  forward_to = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
  job_name = "integrations/unix"
}

prometheus.remote_write "mimir" {
  endpoint {
    // Automatically uses the IP of node2 from your Ansible inventory
    url = "http://{{ hostvars['node2']['ansible_host'] }}:9009/api/v1/push"
  }
}

// Local system logs (syslog & auth/secure)
local.file_match "system_logs" {
  path_targets = [
    {"__path__" = "/var/log/*.log"},
    {"__path__" = "/var/log/syslog"},
    {"__path__" = "/var/log/secure"},
  ]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
  forward_to = [loki.write.loki_server.receiver]
}

loki.write "loki_server" {
  endpoint {
    // Automatically uses the IP of node2 from your Ansible inventory
    url = "http://{{ hostvars['node2']['ansible_host'] }}:3100/loki/api/v1/push"
  }
}
